{
  "name": "pimp-my-site",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "biome check . && node scripts/check-boundaries.mjs",
    "format": "biome format --write .",
    "test": "vitest run",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
